{
  "version": 2,
  "builds": [
    {
      "src": "backend/api/agent.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/agent",
      "dest": "backend/api/agent.js"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/build/web/$1"
    }
  ],
  "env": {
    "OPENAI_API_KEY": "@openai_api_key",
    "OPENAI_MODEL": "gpt-4o-mini"
  },
  "functions": {
    "backend/api/agent.js": {
      "maxDuration": 30
    }
  }
}
