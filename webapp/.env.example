# Supabase (клиентские ключи — только anon / publishable)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Достаточно одного из двух (в Dashboard может называться publishable):
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Пусто = тот же origin (Vercel) или прокси Vite на localhost:3000
# Для отдельного API: VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=

# Кнопка «Пропустить вход» задаётся в vite.config (dev + VERCEL_ENV preview).
# В Production на Vercel кнопки не будет.
