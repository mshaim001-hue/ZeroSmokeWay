# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.4-mini

# Server Configuration
PORT=3000
NODE_ENV=development

# Features Configuration
# Включить sub-агенты для анализа и улучшения ответов (увеличивает задержку и стоимость, но улучшает качество)
USE_SUB_AGENTS=false

# Метрика заполненности старой анкеты; больше не завершает игру Лила.
# В Лиле переход к мифам происходит после предложения итога и выбора пользователя.
# ANAMNESIS_COVERAGE_THRESHOLD=0.72

# Supabase — для сохранения диалогов, RAG в БД и проверки JWT на API
# URL и publishable/anon — как во frontend; service_role — только на сервере (никогда в клиент).
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=eyJ... или sb_publishable_...
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
