# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Server Configuration
PORT=3000
NODE_ENV=development

# Features Configuration
# Включить sub-агенты для анализа и улучшения ответов (увеличивает задержку и стоимость, но улучшает качество)
USE_SUB_AGENTS=false

# Включить адаптивный режим анамнеза с function calling (экспериментально)
USE_ADAPTIVE_ANAMNESIS=false

# Supabase Configuration (опционально, только если нужен доступ к БД из backend)
# Для текущей архитектуры НЕ требуется - Supabase используется только во frontend
